def find_target():
    if len(sys.argv) > 1:
        if sys.argv[1] in ('-h', '--help'):
            print(__doc__.strip())
            sys.exit(0)
        return sys.argv[1]
    if os.environ.get('HOWDOI_PY'):
        return os.environ['HOWDOI_PY']
    prefix = subprocess.check_output(['brew', '--prefix', 'howdoi'], text=True).strip()
    matches = glob.glob(os.path.join(prefix, 'libexec/lib/python*/site-packages/howdoi/howdoi.py'))
    if not matches:
        sys.exit('Could not find howdoi.py under ' + prefix)
    return matches[0]


def write_source(path, src):
    tmp = path + '.howdoi-fix.tmp'
    with open(tmp, 'w') as handle:
        handle.write(src)
    os.replace(tmp, path)


def apply_block(src, path, name, new, olds):
    if new in src:
        return src
    for old in olds:
        if old in src:
            return src.replace(old, new, 1)
    sys.exit('Unexpected howdoi source (missing %s); aborting: %s' % (name, path))


def main():
    path = find_target()
    with open(path) as handle:
        src = handle.read()

    if NEW_GET_LINKS in src and NEW_STASH_SAVE in src and NEW_FORMAT_ANSWERS in src:
        print('Already patched: ' + path)
        return

    src = apply_block(src, path, 'imports', NEW_IMPORT, (ORIG_IMPORT,))

    if SE_API_KEY not in src:
        if SE_API_ORIG in src:
            src = src.replace(SE_API_ORIG, SE_API_KEY, 1)
        elif SE_API_KEY_V1 in src:
            src = src.replace(SE_API_KEY_V1, SE_API_KEY, 1)
        elif ORIG_GET_RESULT in src:
            src = src.replace(ORIG_GET_RESULT, NEW_GET_RESULT, 1)
        else:
            sys.exit('Unexpected howdoi source (missing _se_api/_get_result); aborting: ' + path)

    src = apply_block(src, path, '_get_links', NEW_GET_LINKS, (GET_LINKS_V1, ORIG_GET_LINKS))
    src = apply_block(src, path, '_format_answers', NEW_FORMAT_ANSWERS, (ORIG_FORMAT_ANSWERS,))
    src = apply_block(src, path, '_stash_save', NEW_STASH_SAVE, (ORIG_STASH_SAVE,))
    src = apply_block(src, path, '--empty', NEW_EMPTY, (ORIG_EMPTY,))

    write_source(path, src)
    print('Patched: ' + path)


if __name__ == '__main__':
    main()
